# LiveKit Cloud (STT, LLM y TTS se consumen vía LiveKit Inference con estas credenciales)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=kognia-voice

# Socrata (opcional; sin token la API funciona con límites más bajos)
SOCRATA_APP_TOKEN=
SOCRATA_CACHE_TTL_S=600

# API HTTP
CORS_ORIGINS=http://localhost:4200

# Audio con micrófono compartido
# none | quail_l (recomendado: quita ruido y conserva todas las voces) | quail_vf_s | quail_vf_l (aíslan una sola voz)
NOISE_MODEL=quail_l
# NOISE_ENHANCEMENT_LEVEL=0.6

# Turnos: wake_word ("Kognia, ..." o pregunta clara sobre IPS) | open
TURN_MODE=open
FOLLOW_UP_WINDOW_S=8
# Frase neutra si una consulta tarda (segundos de espera); negativo la desactiva
TOOL_FILLER_DELAY_S=0.7
