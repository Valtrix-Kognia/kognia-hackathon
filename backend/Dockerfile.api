# Kognia Voice HTTP API (FastAPI): session tokens and read-only IPS endpoints.
# Lightweight image: no LiveKit Agents, torch or NLP models.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY pyproject.toml ./
COPY app ./app
RUN pip install . && adduser --disabled-password --gecos "" --uid 10001 appuser
USER appuser
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
